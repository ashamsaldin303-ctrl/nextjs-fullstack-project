# =============================================================================
# Elyra — environment template (Hotfix 01 / H-2)
# Copy to `.env` and fill in. NEVER commit real secrets (.env stays ignored).
# =============================================================================

# --- Database ---------------------------------------------------------------
# IMPORTANT (H-3): in the standalone server a RELATIVE path breaks every
# write with a 500 — relative DB paths resolve from CWD, which differs from
# the standalone bundle directory. ALWAYS use an ABSOLUTE path in production
# (dev's `file:./db/custom.db` works only with `bun run dev`).
DATABASE_URL=file:/app/db/custom.db

# --- Site URL (REQUIRED AT BUILD TIME) ---------------------------------------
# Absolute public URL of the deployed site — inlined at build time into
# canonical URLs, hreflang alternates, sitemap, OpenGraph and JSON-LD.
# If missing, every canonical points at localhost: measurable SEO damage.
# HARD GATE (F-S4-01): `next build` FAILS when this is unset — see the
# assertion at the top of next.config.ts.
NEXT_PUBLIC_SITE_URL=https://elyra.agency

# --- Contact channels (F-S10-01 — REQUIRED BEFORE LAUNCH) -------------------
# Real contact accounts consumed by footer / contact page / WhatsApp deep
# links / JSON-LD via src/lib/site-config.ts (env-first, code defaults as
# fallback). The WhatsApp default in code is still the placeholder number
# — scripts/check-site-contact.mjs warns on every CI run until a REAL
# business number lands here in the production .env (audit D26 blocker).
NEXT_PUBLIC_CONTACT_EMAIL=hello@elyra.agency
NEXT_PUBLIC_CONTACT_WHATSAPP=963991000000
NEXT_PUBLIC_CONTACT_TELEGRAM=elyra_agency

# --- n8n webhook (optional — silently disabled when unset) ------------------
# Fires after every stored lead (calculator + contact form) with an
# HMAC-SHA256 signed payload. See README "Webhook verification recipe".
N8N_WEBHOOK_URL=
# Secret MUST be 32+ characters. Generate with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# --- Reverse proxy trust (audit P1-1 / F-S1-06 — HARD REQUIREMENT) -------------
# ⚠️ HARD REQUIREMENT, not a recommendation: TRUST_PROXY=true is safe ONLY
# behind an OVERWRITING reverse proxy (deploy/Caddyfile.example) that
# replaces X-Forwarded-For/X-Real-IP with the real client address. Direct
# exposure with this flag on makes rate-limit keys attacker-choosable
# (the app additionally validates the IP shape via net.isIP and the proxy
# layer logs a one-time warning — see src/proxy.ts + api/leads/route.ts).
# Appending proxies (nginx proxy_add_x_forwarded_for) are NOT supported —
# the rate limiter reads the LAST XFF element.
TRUST_PROXY=false

# --- Stitch design tooling (optional, dev-time only) ---------------------------
# Consumed ONLY by scripts/stitch.ts (@google/stitch-sdk is a devDependency;
# the app in src/ never reads it, nothing ships client-side). Needed for the
# design-generation workflow (bun scripts/stitch.ts …) — see worklog G3-1.
# Key rules (G1-C/G2-5): env-only (bun auto-loads .env), never a CLI argument,
# never printed. Get a key from Google AI Studio / Stitch settings.
STITCH_API_KEY=
