# ⚠️ SANDBOX-ONLY FILE — NOT FOR PRODUCTION
# This config intentionally proxies to arbitrary localhost ports via ?XTransformPort
# (an open-proxy/SSRF primitive by design, for the preview tooling). NEVER deploy
# this publicly. In production terminate TLS at a real reverse proxy that
# overwrites X-Forwarded-For (and set TRUST_PROXY=true in the app).
:81 {
	@transform_port_query {
		query XTransformPort=*
	}

	handle @transform_port_query {
		reverse_proxy localhost:{query.XTransformPort} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
