// Elyra — Prisma schema (Phase 1)
// The Lead model backs the project calculator + contact form submissions.
// Phase 3 will wire POST /api/leads with server-side recompute (guide §2.9)
// and an HMAC-signed n8n webhook.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Captured calculator estimates & contact inquiries (audit P1-3).
// `integrations` is a JSON-serialized array of IntegrationKey values —
// SQLite has no scalar list type, so we serialize (guide code-style rule).
model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String
  whatsapp        String?
  service         String
  pages           Int
  languages       String
  threeD          String
  integrations    String // JSON serialized: IntegrationKey[]
  automationLevel String
  minBudget       Int
  maxBudget       Int
  weeksMin        Int
  weeksMax        Int
  ipAddress       String?
  userAgent       String?
  status          String   @default("new") // new | contacted | won | lost
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
