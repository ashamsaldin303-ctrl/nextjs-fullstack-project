.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# database (SQLite) — never track lead data (audit P1-3); history contains
# only synthetic test data, but future rows would be real PII.
db/*.db
db/*.db-wal
db/*.db-shm
